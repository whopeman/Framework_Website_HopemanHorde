# .gitignore
# Project : Framework_Website_HopemanHorde
# Date    : 2026-10-26
# Purpose : Keep build output, dependencies and all secrets out of git.
# Change log:
#   2026-10-26  0.1.0  Initial ignore list.
#   2026-10-26  0.3.0  Ignore deploy.local.json.

# Hugo output and caches
public/
resources/
.hugo_build.lock

# Node
node_modules/

# Secrets - never commit
.ssh/
*.key
*.pem
id_*
*token*
.env*
deploy.local.json
*.secret
*login*.txt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
